# Postgres and Redis from `docker compose up db redis`. Used by `go run .` and `go run ./cmd/seed`.
# Add &pool_max_conns=N to change the pool size (default 20).
DATABASE_URL=postgres://cashback:cashback@localhost:5432/cashback?sslmode=disable
REDIS_URL=redis://localhost:6379/0
# debug, info, warn or error
LOG_LEVEL=info
